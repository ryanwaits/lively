# The Lively WebSocket server the marketing page's live cursors connect to.
#
# Production: the Render service the hosted demos already use.
#   NEXT_PUBLIC_LIVELY_URL=https://lively-ws.waits.dev
#
# Local: run `bun run dev:server` in this directory and point at it.
#   NEXT_PUBLIC_LIVELY_URL=http://localhost:1999
#
# The client swaps http -> ws itself and appends /rooms/<roomId>, so give it
# the plain origin with no trailing slash and no trailing newline.
NEXT_PUBLIC_LIVELY_URL=http://localhost:1999
